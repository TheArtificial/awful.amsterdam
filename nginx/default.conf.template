server
{
  listen 80;
  listen [::]:80;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  # Keep redirects relative when HTTPS terminates at a reverse proxy.
  absolute_redirect off;

  # Revalidate HTML and unversioned assets, including media and CSS aliases.
  add_header Cache-Control 'public, max-age=0, must-revalidate' always;

  # Health checks should not be cached or depend on generated site files.
  location = /healthz
  {
    access_log off;
    default_type text/plain;
    add_header Cache-Control 'no-store' always;
    return 200 "ok\n";
  }

  # Only content-hashed CSS gets immutable caching; missing files do not.
  location ~ '^/css/(site|style)\.[a-f0-9]{8}\.css$'
  {
    add_header Cache-Control 'public,max-age=31536000,immutable';
    try_files $uri =404;
  }

  # Preserve directory redirects and extensionless Netlify-style pretty URLs.
  location /
  {
    if (-d $request_filename)
    {
      rewrite ^(.+[^/])$ $1/ permanent;
    }

    try_files $uri $uri/index.html $uri.html =404;
  }
}
