<!doctype html>
<html lang="en">
  <head>
    {% set metadataTitle = title or (date + ' awful.amsterdam') -%}
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ metadataTitle | escape }}</title>
    <meta name="title" content="{{ metadataTitle | escape }}">
    <meta name="author" content="Atelier Awful">
    <meta name="description" content="An awe-inspiring place.">
    <meta name="generator" content="{{ eleventy.generator | escape }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ page.url | escape }}">
    <meta property="og:locale" content="en_NL">
    <meta property="og:title" content="{{ metadataTitle | escape }}">
    <meta property="og:description" content="An awe-inspiring place.">
    <meta property="og:image" content="/favicon.png">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:url" content="{{ page.url | escape }}">
    <meta name="twitter:title" content="{{ metadataTitle | escape }}">
    <meta name="twitter:description" content="An awe-inspiring place.">
    <meta name="twitter:image" content="/favicon.png">
    <link rel="canonical" href="{{ page.url | escape }}">

    <!-- favicon, etc. -->
    <meta name="msapplication-TileColor" content="#12265C">
    <meta name="theme-color" content="#12265C">

    <link rel="stylesheet" href="{{ assetPaths.styles['/css/site.css'] }}" />

		{{ headtags | safe }}
  </head>
  <body class="{{ bodyClass }}">
    <div class="main">
      <nav id="site-nav">
        <div class="flex container">
      		<div class="col-3 right-3">
            <div class="padded">
              <a href="/"><img class="logo" src="/img/awful-horilogo.svg"></a>
            </div>
          </div>
          <div class="col-6">
            <!--
            <div class="padded nav">
              <a class="nav-link" href="/events/">Events</a>
              <a class="nav-link" href="/artists/">Artists</a>
              <a class="nav-link" href="/collection/">Collection</a>
            </div>
            -->
          </div>
        </div>
      </nav>

      {% block content %}
      {{ content | safe }}
      {% endblock %}

      <section id="footer">
        <div class="spacer"></div>
        <div class="flex container">
          <div class="col-12">
            <div class="padded center">
              <p class="footer">&copy; 2023 Atelier Awful</p>
            </div>
          </div>
        </div>
	    </section>
    </div>

    <script>
      var lazyLoadInstance = new LazyLoad({
        elements_selector: "img"
      });
    </script>
  </body>
</html>
